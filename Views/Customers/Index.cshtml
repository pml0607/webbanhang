@{
    ViewData["Title"] = "Customers";
}

<section class="customer-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Customers</h1>
            <p class="text-muted mb-0">Manage customer details for your store.</p>
        </div>
        <span class="badge text-bg-primary fs-6"><span id="customer-count">0</span> customers</span>
    </div>

    <div class="alert alert-info" role="status">
        Demo only: changes stay in this page session and are cleared when you reload.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-0" id="customer-form-title">Add customer</h2>
        </div>
        <div class="card-body">
            <form id="customer-form" class="row g-3">
                <input id="customer-id" type="hidden" />
                <div class="col-md-6">
                    <label for="customer-name" class="form-label">Full name</label>
                    <input id="customer-name" class="form-control" required maxlength="100" autocomplete="name" />
                </div>
                <div class="col-md-6">
                    <label for="customer-email" class="form-label">Email</label>
                    <input id="customer-email" type="email" class="form-control" required maxlength="254" autocomplete="email" />
                </div>
                <div class="col-md-6">
                    <label for="customer-phone" class="form-label">Phone</label>
                    <input id="customer-phone" type="tel" class="form-control" required maxlength="30" autocomplete="tel" />
                </div>
                <div class="col-md-6">
                    <label for="customer-city" class="form-label">City</label>
                    <input id="customer-city" class="form-control" required maxlength="80" autocomplete="address-level2" />
                </div>
                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit" id="customer-submit">Add customer</button>
                    <button class="btn btn-outline-secondary d-none" type="button" id="customer-cancel">Cancel edit</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap align-items-center justify-content-between gap-2">
            <h2 class="h5 mb-0">Customer list</h2>
            <label class="visually-hidden" for="customer-search">Search customers</label>
            <input id="customer-search" class="form-control" type="search" placeholder="Search customers..." />
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Email</th>
                        <th scope="col">Phone</th>
                        <th scope="col">City</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="customer-rows"></tbody>
            </table>
        </div>
        <div id="customer-empty" class="p-4 text-center text-muted d-none">No customers match your search.</div>
    </div>
</section>

@section Scripts {
    <script src="~/js/customers.js" asp-append-version="true"></script>
}
